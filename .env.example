# ─── Database ───────────────────────────────────────────────────────────────
# Change ALL three values before deploying to production.
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel

# ─── App environment ─────────────────────────────────────────────────────────
APP_ENV=production

# ─── Host ports (change if they conflict with existing services) ──────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
REDPANDA_PORT=9092
GATEWAY_PORT=8080
AGGREGATOR_PORT=8081
FEATURES_PORT=8082
INFERENCE_PORT=8090
ALERTS_PORT=8083
GOVERNANCE_PORT=8084
QUERY_PORT=8085
WEB_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_API_PORT=8443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ─── Grafana admin password ───────────────────────────────────────────────────
# Change before deploying to production.
GRAFANA_PASSWORD=sentinel

# ─── Simulator tuning ────────────────────────────────────────────────────────
SIM_INTERVAL_MS=500
SIM_ANOMALY_EVERY=40
SIM_SYMBOLS=AAPL,MSFT,TSLA,NVDA,BTC-USD

# ─── Local URLs (for running services outside Docker) ────────────────────────
KAFKA_BROKER=localhost:9092
REDIS_ADDR=localhost:6379
MEMCACHED_ADDR=localhost:11211
HTTP_ADDR=:8080
JWT_PRIVATE_KEY=./keys/jwtRS256.key
JWT_PUBLIC_KEY=./keys/jwtRS256.key.pub

# ─── Local dev only ───────────────────────────────────────────────────────────
# Set DEV_UNSAFE=true ONLY on a local machine where Redis is unavailable.
# Enables in-memory CSRF/rate-limit fallback. NEVER set in production.
# DEV_UNSAFE=true
