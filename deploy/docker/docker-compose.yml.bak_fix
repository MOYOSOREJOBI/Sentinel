services:
  redpanda:
    image: redpandadata/redpanda:v24.1.10
    command: ["redpanda","start","--overprovisioned","--smp","1","--memory","1G","--reserve-memory","0M","--node-id","0","--check=false","--kafka-addr","PLAINTEXT://0.0.0.0:9092","--advertise-kafka-addr","PLAINTEXT://redpanda:9092"]
    ports: ["9092:9092"]
    healthcheck:
      test: ["CMD","rpk","cluster","info"]
      interval: 5s
      timeout: 3s
      retries: 30

  postgres:
    image: timescale/timescaledb:2.15.1-pg16
    environment: {POSTGRES_DB: sentinel, POSTGRES_USER: sentinel, POSTGRES_PASSWORD: sentinel}
    ports: ["5432:5432"]
    healthcheck:
      test: ["CMD-SHELL","pg_isready -U sentinel -d sentinel"]
      interval: 5s
      timeout: 3s
      retries: 30

  redis:
    image: redis:7
    ports: ["6379:6379"]
    healthcheck:
      test: ["CMD","redis-cli","ping"]
      interval: 5s
      timeout: 3s
      retries: 30

  memcached:
    image: memcached:1.6
    profiles: ["optional-cache"]
    ports: ["11211:11211"]

  migrate:
    image: timescale/timescaledb:2.15.1-pg16
    restart: "no"
    volumes: ["../../sql/migrations:/migrations:ro"]
    depends_on:
      postgres: {condition: service_healthy}
    entrypoint: ["/bin/sh", "-ec"]
    command: |
      find /migrations -maxdepth 1 -name '*.sql' -print | sort | \
        xargs -r -I{} sh -ec 'echo "Applying {}"; psql postgresql://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable -v ON_ERROR_STOP=1 -f "{}"'

  topics-init:
    image: redpandadata/redpanda:v24.1.10
    restart: "no"
    depends_on:
      redpanda: {condition: service_healthy}
    entrypoint: ["/bin/sh", "-ec"]
    command: |
      printf '%s\n' raw.ticks derived.candles derived.features derived.scores alerts.created dq.metrics dlq.aggregator dlq.features dlq.inference dlq.alerts | \
        xargs -r -I{} sh -ec 'rpk topic create "{}" --brokers redpanda:9092 --partitions 3 --replicas 1 || true; rpk topic describe "{}" --brokers redpanda:9092 >/dev/null'

  gateway-api:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: gateway-api}}
    environment: [HTTP_ADDR=:8080,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable,KAFKA_BROKER=redpanda:9092,JWT_PRIVATE_KEY=/app/keys/jwtRS256.key,JWT_PUBLIC_KEY=/app/keys/jwtRS256.key.pub]
    ports: ["8080:8080"]
    depends_on:
      migrate: {condition: service_completed_successfully}
      topics-init: {condition: service_completed_successfully}

  simulator:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: simulator}}
    environment: [KAFKA_BROKER=redpanda:9092,SIM_INTERVAL_MS=500,SIM_ANOMALY_EVERY=40]
    depends_on:
      topics-init: {condition: service_completed_successfully}

  aggregator:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: aggregator}}
    environment: [HTTP_ADDR=:8081,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable,KAFKA_BROKER=redpanda:9092]
    ports: ["8081:8081"]
    depends_on:
      migrate: {condition: service_completed_successfully}
      topics-init: {condition: service_completed_successfully}

  features:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: features}}
    environment: [HTTP_ADDR=:8082,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable,KAFKA_BROKER=redpanda:9092]
    ports: ["8082:8082"]
    depends_on:
      migrate: {condition: service_completed_successfully}
      topics-init: {condition: service_completed_successfully}

  inference:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile.inference}
    environment: [KAFKA_BROKER=redpanda:9092]
    ports: ["8090:8090"]
    depends_on:
      topics-init: {condition: service_completed_successfully}
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8090/healthz')\""]
      interval: 5s
      timeout: 3s
      retries: 30

  alerts:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: alerts}}
    environment: [HTTP_ADDR=:8083,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable,KAFKA_BROKER=redpanda:9092,JWT_PUBLIC_KEY=/app/keys/jwtRS256.key.pub]
    ports: ["8083:8083"]
    depends_on:
      migrate: {condition: service_completed_successfully}
      topics-init: {condition: service_completed_successfully}

  governance:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: governance}}
    environment: [HTTP_ADDR=:8084,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable,JWT_PUBLIC_KEY=/app/keys/jwtRS256.key.pub]
    ports: ["8084:8084"]
    depends_on:
      migrate: {condition: service_completed_successfully}

  query:
    build: {context: ../.., dockerfile: deploy/docker/Dockerfile-go, args: {SERVICE: query}}
    environment: [HTTP_ADDR=:8085,POSTGRES_URL=postgres://sentinel:sentinel@postgres:5432/sentinel?sslmode=disable]
    ports: ["8085:8085"]
    depends_on:
      migrate: {condition: service_completed_successfully}

  web:
    image: node:20-alpine
    working_dir: /app/web
    volumes: ["../../:/app"]
    environment: [NODE_ENV=development, NEXT_TELEMETRY_DISABLED=1]
    command: sh -c "npm install --prefer-offline && npm run dev"
    ports: ["3000:3000"]
    depends_on: [gateway-api,query]

  prometheus:
    image: prom/prometheus:v2.54.1
    volumes: ["../../prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro"]
    ports: ["9090:9090"]

  grafana:
    image: grafana/grafana:11.1.4
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=sentinel
      - GF_AUTH_ANONYMOUS_ENABLED=true
      - GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
    volumes:
      - "../../grafana/sentinel-dashboard.json:/var/lib/grafana/dashboards/sentinel-dashboard.json:ro"
    ports: ["3001:3000"]
